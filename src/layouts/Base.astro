---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'Marwan Hatem, AI Engineer',
  description = 'Marwan Hatem is an AI engineer in Cairo building computer vision, deep learning, LLM and n8n automation systems.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const links = [['Projects', '#projects'], ['About', '#about'], ['Skills', '#skills'], ['Certificates', '#certificates'], ['Contact', '#contact']];
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Marwan Hatem',
  jobTitle: 'AI Engineer', url: Astro.site?.toString(),
  email: 'mailto:marwan55hatem@gmail.com',
  sameAs: ['https://github.com/marwan55hatem', 'https://www.linkedin.com/in/marwan-hatem/'],
  alumniOf: 'Arab Open University',
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Marwan Hatem" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
      document.documentElement.dataset.theme = t || 'light';
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-[var(--panel)] focus:px-4 focus:py-2">Skip to content</a>
  <header class="bar">
    <div class="wrap">
      <a href={home} class="name">Marwan Hatem</a>
      <nav aria-label="Sections">
        {links.map(([l, h]) => <a href={home + h}>{l}</a>)}
      </nav>
      <button class="theme-btn" id="theme" type="button" aria-label="Switch colour theme">Dark</button>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer><div class="wrap">© {new Date().getFullYear()} Marwan Hatem, Cairo</div></footer>
  <script>
    const root = document.documentElement;
    const btn = document.getElementById('theme')!;
    const label = () => { btn.textContent = root.dataset.theme === 'dark' ? 'Light' : 'Dark'; };
    label();
    btn.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      label();
    });
  </script>
</body>
</html>
