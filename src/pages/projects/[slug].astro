---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${d.title} | Marwan Hatem`} description={d.summary}>
  <section style="padding-top:140px">
    <div class="container prose">
      <a href={`${base}/#projects`} class="plink">← All projects</a>
      <div class="sh" style="margin-top:28px">
        <span class="tag">// {d.category}{d.date && ` · ${d.date}`}</span>
        <h1 style="font-size:clamp(32px,5vw,52px);font-weight:800">{d.title}</h1>
        <p>{d.summary}</p>
      </div>
      <div class="tags" style="margin-bottom:12px">{d.tags.map((t) => <span>{t}</span>)}</div>
      <Content />
      {d.github && <p><a class="plink" href={d.github} target="_blank" rel="noopener">View on GitHub ↗</a></p>}
    </div>
  </section>
</Base>
