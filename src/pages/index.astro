---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import jelecom from '../assets/certs/jelcom-ml.png';
import aou from '../assets/certs/aou-ml.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const timeline = [
  ['Feb 2026 – Present', 'Advanced AI Diploma', 'Instant Software Solutions: deep learning, computer vision, NLP, LLMs, RAG and MLOps, including an LLM project.'],
  ['Jul – Dec 2025', 'Data Engineer & AI', 'DEPI: data pipelines, dataset cleaning, and supporting ML model integration and deployment.'],
  ['Aug 2024', 'ML & Computer Vision Fundamentals', 'Arab Open University: object detection, edge detection, segmentation, deep learning basics.'],
  ['Sept 2023 – Feb 2027', 'BSc in Artificial Intelligence', 'Arab Open University.'],
];
const skills = [
  ['🤖', 'AI & Deep Learning', ['PyTorch', 'TensorFlow', 'Computer Vision', 'NLP', 'LLMs', 'RAG', 'MLOps', 'HuggingFace', 'YOLOv8']],
  ['💻', 'Programming & Engineering', ['Python', 'OOP', 'FastAPI', 'PyQt5', 'SQLite']],
  ['🔗', 'Data & Automation', ['Data Visualization', 'Data Pipelines', 'n8n', 'OpenAI / OpenRouter APIs']],
];
const soft = ['Leadership', 'Teamwork', 'Presentation', 'Time Management', 'Communication', 'Project Management', 'Problem Solving'];
const certs = [
  { img: aou, title: 'Fundamentals of Data Science and Machine Learning', by: 'Arab Open University, Egypt · Jun – Aug 2024' },
  { img: jelecom, title: 'Machine Learning Basics (40 hrs) · Grade: Excellent', by: 'Jelecom Egypt · Aug – Sep 2023' },
];
---
<Base>
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div>
        <div class="badge"><span class="dot"></span>Open to AI engineering opportunities</div>
        <h1>Hi, I'm <span class="grad">Marwan Hatem</span></h1>
        <div class="role">AI Engineer building real-world intelligent systems</div>
        <p class="lead">I work across machine learning, deep learning, computer vision, NLP and LLMs, and connect them with n8n automation so models do useful work instead of sitting in notebooks.</p>
        <p class="edu mono">BSc in Artificial Intelligence · Arab Open University · Sept 2023 – Feb 2027</p>
        <div class="cta">
          <a href="#projects" class="btn btn-p">View my work →</a>
          <a href="/Marwan_Hatem_CV.pdf" download class="btn btn-s">Download CV</a>
          <a href="#contact" class="btn btn-s">Contact</a>
        </div>
      </div>
      <div class="hero-card" aria-hidden="true">
        <div class="bar"><i></i><i></i><i></i></div>
        <pre><span class="k">class</span> Engineer:
  name   = <span class="s">"Marwan Hatem"</span>
  focus  = [<span class="s">"CV"</span>, <span class="s">"DL"</span>, <span class="s">"NLP"</span>,
            <span class="s">"LLMs"</span>, <span class="s">"RAG"</span>]
  ships  = <span class="s">"things that work"</span>
  based  = <span class="s">"Cairo, Egypt"</span></pre>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <div class="sh rv"><span class="tag">// about</span><h2>Engineering AI that <span class="grad">ships</span></h2></div>
      <div class="about-grid">
        <div class="rv">
          <p>I'm a <strong>computer science engineer specializing in artificial intelligence</strong>, with academic training in machine learning and deep learning and a habit of turning theory into working systems.</p>
          <p>I build <strong>automation workflows with n8n</strong> and fold them into real projects, connecting AI components so whole processes run on their own. My work spans a fully local desktop assistant, a from-scratch medical imaging CNN, and a content pipeline wired to LLM APIs.</p>
          <p>I pair the technical side with leadership, teamwork and clear communication, and I'm always looking for the next hard problem to learn from.</p>
          <div class="stats">
            <div class="stat"><b class="grad">3</b><span>Shipped projects</span></div>
            <div class="stat"><b class="grad">300+</b><span>Automated tests</span></div>
            <div class="stat"><b class="grad">15</b><span>Tumor classes</span></div>
          </div>
        </div>
        <div class="tl rv">
          {timeline.map(([when, what, desc]) => (
            <div class="tl-i"><small>{when}</small><h3>{what}</h3><p>{desc}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="container">
      <div class="sh rv"><span class="tag">// projects</span><h2>Selected <span class="grad">work</span></h2><p>Systems I've designed and built end to end. Open one for the full case study.</p></div>
      <div class="pgrid">
        {projects.map((p) => <ProjectCard id={p.id} data={p.data} />)}
      </div>
    </div>
  </section>

  <section id="skills">
    <div class="container">
      <div class="sh rv"><span class="tag">// skills</span><h2>Tools I <span class="grad">build with</span></h2></div>
      <div class="sgrid">
        {skills.map(([icon, title, items]) => (
          <div class="sk rv"><div class="ic" aria-hidden="true">{icon}</div><h3>{title}</h3><ul>{(items as string[]).map((s) => <li>{s}</li>)}</ul></div>
        ))}
      </div>
      <div class="soft rv"><b>Personal skills</b>{soft.map((s) => <span>{s}</span>)}</div>
    </div>
  </section>

  <section id="certificates">
    <div class="container">
      <div class="sh rv"><span class="tag">// certificates</span><h2>Training &amp; <span class="grad">certifications</span></h2></div>
      <div class="cert-grid">
        {certs.map((c) => (
          <figure class="cert rv">
            <Image src={c.img} alt={`Certificate: ${c.title}`} widths={[400, 700]} sizes="(min-width:700px) 340px, 100vw" loading="lazy" />
            <div><h3>{c.title}</h3><p>{c.by}</p></div>
          </figure>
        ))}
        <a class="cert rv" href="/certificates/depi-data-engineer.pdf" target="_blank" rel="noopener">
          <div style="padding:40px 24px;text-align:center"><div style="font-size:44px" aria-hidden="true">📄</div></div>
          <div><h3>Microsoft Data Engineer, Digital Egypt Pioneers Program</h3><p>DEPI · Jun – Dec 2025 · View PDF ↗</p></div>
        </a>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <div class="sh rv"><span class="tag">// contact</span><h2>Let's build something <span class="grad">together</span></h2><p>Have a project, role or idea in mind? I'd love to hear about it.</p></div>
      <div class="cgrid">
        <div class="rv">
          <div class="ci">
            <a href="mailto:marwan55hatem@gmail.com"><div class="i">✉️</div><div><small>Email</small><span>marwan55hatem@gmail.com</span></div></a>
            <a href="tel:+201006453612"><div class="i">📞</div><div><small>Phone</small><span>+20 100 645 3612</span></div></a>
            <div><div class="i">📍</div><div><small>Location</small><span>Gesr Al Suez, Cairo, Egypt</span></div></div>
          </div>
          <div class="soc">
            <a href="https://github.com/marwan55hatem" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/marwan-hatem/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://wa.me/201006453612" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
        <form id="form" class="rv" action="https://formspree.io/f/xqayjrdg" method="POST">
          <div><label for="n">Name</label><input id="n" name="name" required autocomplete="name" /></div>
          <div><label for="e">Email</label><input id="e" type="email" name="email" required autocomplete="email" /></div>
          <div><label for="m">Message</label><textarea id="m" name="message" required></textarea></div>
          <button class="btn btn-p" id="send" type="submit">Send message</button>
          <div id="fs" role="status"></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('form') as HTMLFormElement | null;
  const fs = document.getElementById('fs')!;
  const send = document.getElementById('send') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    send!.disabled = true; fs.className = ''; fs.textContent = 'Sending…';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error();
      fs.className = 'ok'; fs.textContent = 'Thanks! Your message was sent.'; form.reset();
    } catch {
      fs.className = 'err'; fs.textContent = 'Something went wrong. Please email me directly.';
    } finally { send!.disabled = false; }
  });
</script>
