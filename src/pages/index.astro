---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Inference from '../components/Inference.astro';
import jelecom from '../assets/certs/jelcom-ml.png';
import aou from '../assets/certs/aou-ml.png';
import depi from '../assets/certs/depi-data-engineer.png';
import diploma from '../assets/certs/advanced-ai-diploma.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const focus = ['Computer Vision', 'Deep Learning', 'NLP', 'LLMs', 'RAG', 'Automation'];
const education = [
  ['Sep 2023 – Feb 2027', 'BSc in Artificial Intelligence, Arab Open University', 'Machine learning and deep learning coursework, Cairo.'],
];
const skills = [
  ['Deep learning', ['PyTorch', 'TensorFlow', 'Custom CNNs', 'Grad-CAM']],
  ['Computer vision', ['YOLOv8', 'Classification', 'Segmentation', 'Object detection']],
  ['Language models', ['HuggingFace', 'BART', 'MarianMT', 'LLMs', 'RAG', 'OpenAI / OpenRouter']],
  ['Engineering', ['Python', 'OOP / SOLID', 'FastAPI', 'PyQt5', 'SQLite', 'Automated testing']],
  ['Data & automation', ['n8n', 'Data pipelines', 'Data visualisation', 'MLOps']],
  ['Working style', ['Leadership', 'Teamwork', 'Presenting', 'Project management', 'Problem solving']],
];
const certs: { img: ImageMetadata; title: string; by: string; pdf?: string }[] = [
  { img: diploma, title: 'Advanced AI Diploma, 150 hours', by: 'Instant Software Solutions, completed Oct 2026' },
  { img: depi, title: 'Microsoft Data Engineer, Digital Egypt Pioneers Program', by: 'DEPI, Ministry of Communications and IT, Jun – Dec 2025', pdf: '/certificates/depi-data-engineer.pdf' },
  { img: aou, title: 'Fundamentals of Data Science and Machine Learning', by: 'Arab Open University, Jun – Aug 2024' },
  { img: jelecom, title: 'Machine Learning Basics, 40 hours, graded Excellent', by: 'Jelecom Egypt, Aug – Sep 2023' },
];
const certHref = (c: (typeof certs)[number]) => (c.pdf ? `${base}${c.pdf}` : c.img.src);
const experience = [
  {
    when: 'Feb – Oct 2026', role: 'Advanced AI Diploma', org: 'Instant Software Solutions', kind: '150-hour diploma', cert: certs[0],
    points: [
      'Studied deep learning, computer vision, NLP, LLMs, RAG and MLOps.',
      'Focused on building, deploying and optimising real-world AI systems.',
      'Worked on an LLM project as part of the program.',
    ],
  },
  {
    when: 'Jun – Dec 2025', role: 'Microsoft Data Engineer', org: 'Digital Egypt Pioneers Program (DEPI)', kind: 'National training program', cert: certs[1],
    points: [
      'Built and optimised data pipelines.',
      'Prepared and cleaned datasets for AI applications.',
      'Worked with ML engineers to support model integration and deployment.',
    ],
  },
  {
    when: 'Jun – Aug 2024', role: 'Fundamentals of Data Science and Machine Learning', org: 'Arab Open University', kind: 'Certificate program', cert: certs[2],
    points: [
      'Learned machine learning and image processing foundations.',
      'Covered object detection, edge detection, image segmentation and deep learning basics.',
    ],
  },
  {
    when: 'Aug – Sep 2023', role: 'Machine Learning Basics', org: 'Jelecom Egypt', kind: '40-hour training program', cert: certs[3],
    points: ['Completed the program with a general grade of Excellent.'],
  },
];
---
<Base>
  <div class="wrap card">
    <div class="main">
      <section class="intro" id="home">
        <h1>Marwan Hatem</h1>
        <p class="role">AI engineer in Cairo. I train models and build the software around them.</p>
        <ul class="tags" aria-label="Focus areas">{focus.map((f) => <li>{f}</li>)}</ul>
        <div class="mobile-cta">
          <a class="btn primary" href={`${base}/Marwan_Hatem_CV.pdf`} target="_blank" rel="noopener">View CV</a>
          <a class="btn ghost" href="#contact">Contact</a>
        </div>
        <Inference />
      </section>

      <section id="projects">
        <h2>Projects</h2>
        <table class="results">
          <thead><tr><th scope="col">Project</th><th scope="col">Task</th><th scope="col">Result</th></tr></thead>
          <tbody>
            {projects.map((p) => (
              <tr>
                <td><a href={`${base}/projects/${p.id}/`}>{p.data.title}</a><small>{p.data.tags.join(', ')}</small></td>
                <td>{p.data.task}</td>
                <td>{p.data.result}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="muted" style="margin-top:14px;font-size:15px">Select a project name to read how it was built.</p>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <p class="muted" style="margin-bottom:8px">Professional training programs, each completed with a certificate.</p>
        <ol class="steps">
          {experience.map((x) => (
            <li>
              <time>{x.when}</time>
              <div>
                <h3>{x.role}</h3>
                <p>{x.org}, {x.kind.charAt(0).toLowerCase() + x.kind.slice(1)}</p>
                <ul class="points">{x.points.map((p) => <li>{p}</li>)}</ul>
                <a class="cert-link" href={certHref(x.cert)} target="_blank" rel="noopener">View certificate</a>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="education">
        <h2>Education</h2>
        <ol class="steps">
          {education.map(([when, what, desc]) => (
            <li><time>{when}</time><div><h3>{what}</h3><p>{desc}</p></div></li>
          ))}
        </ol>
      </section>

      <section id="skills">
        <h2>Skills</h2>
        <dl class="skillset">
          {skills.map(([k, items]) => (
            <div><dt>{k}</dt><dd><ul class="tags">{(items as string[]).map((s) => <li>{s}</li>)}</ul></dd></div>
          ))}
        </dl>
      </section>

      <section id="certificates">
        <h2>Certificates</h2>
        <div class="certs">
          {certs.map((c) => (
            <a class="cert" href={certHref(c)} target="_blank" rel="noopener">
              <div class="frame"><Image src={c.img} alt={`Certificate: ${c.title}`} widths={[400, 700]} sizes="(min-width:960px) 400px, 100vw" loading="lazy" /></div>
              <h3>{c.title}</h3><p>{c.by}</p>
            </a>
          ))}
        </div>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p class="muted">Hiring for an AI role or have a project in mind? Send a message and I'll reply by email.</p>
        <form id="form" action="https://formspree.io/f/xqayjrdg" method="POST">
          <div><label for="n">Your name</label><input id="n" name="name" required autocomplete="name" /></div>
          <div><label for="e">Your email</label><input id="e" type="email" name="email" required autocomplete="email" /></div>
          <div><label for="m">Message</label><textarea id="m" name="message" required></textarea></div>
          <div><button class="btn primary" id="send" type="submit">Send message</button></div>
          <div id="fs" role="status"></div>
        </form>
      </section>
    </div>

    <aside class="side" aria-label="Profile summary">
      <div class="panel">
        <p class="status"><i aria-hidden="true"></i>Open to AI engineering roles</p>
        <div class="btns">
          <a class="btn primary" href={`${base}/Marwan_Hatem_CV.pdf`} target="_blank" rel="noopener">View CV</a>
          <a class="btn ghost" href="mailto:marwan55hatem@gmail.com">Email me</a>
        </div>
      </div>
      <dl class="panel facts">
        <div><dt>Location</dt><dd>Gesr Al Suez, Cairo, Egypt</dd></div>
        <div><dt>Education</dt><dd>BSc Artificial Intelligence, Arab Open University, 2027</dd></div>
        <div><dt>Email</dt><dd><a href="mailto:marwan55hatem@gmail.com">marwan55hatem@gmail.com</a></dd></div>
        <div><dt>Phone and WhatsApp</dt><dd><a href="tel:+201006453612">+20 100 645 3612</a></dd></div>
        <div><dt>Profiles</dt><dd><a href="https://github.com/marwan55hatem" target="_blank" rel="noopener">GitHub</a>, <a href="https://www.linkedin.com/in/marwan-hatem/" target="_blank" rel="noopener">LinkedIn</a></dd></div>
      </dl>
    </aside>
  </div>
</Base>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const fs = document.getElementById('fs')!;
  const send = document.getElementById('send') as HTMLButtonElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    send.disabled = true; fs.className = ''; fs.textContent = 'Sending…';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error();
      fs.className = 'ok'; fs.textContent = 'Message sent. I will reply by email.'; form.reset();
    } catch {
      fs.className = 'err'; fs.textContent = 'The message did not send. Check your connection or email me directly.';
    } finally { send.disabled = false; }
  });
</script>
