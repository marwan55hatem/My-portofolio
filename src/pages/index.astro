---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import jelecom from '../assets/certs/jelcom-ml.png';
import aou from '../assets/certs/aou-ml.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const path = [
  ['Feb 2026 – now', 'Advanced AI Diploma', 'Instant Software Solutions. Deep learning, computer vision, NLP, LLMs, RAG and MLOps, including an LLM project.'],
  ['Jul – Dec 2025', 'Data Engineer & AI, DEPI', 'Built and optimised data pipelines, prepared datasets for AI, and supported model integration and deployment.'],
  ['Aug 2024', 'ML & Computer Vision Fundamentals', 'Arab Open University. Object detection, edge detection, segmentation and deep learning basics.'],
  ['Sep 2023 – Feb 2027', 'BSc in Artificial Intelligence', 'Arab Open University, Cairo.'],
];
const skills = [
  ['Deep learning', 'PyTorch, TensorFlow, custom CNN architectures, Grad-CAM explainability'],
  ['Computer vision', 'YOLOv8 object detection, image classification, segmentation'],
  ['Language & LLMs', 'NLP, HuggingFace Transformers (BART, MarianMT), LLMs, RAG, OpenAI / OpenRouter APIs'],
  ['Engineering', 'Python, OOP and SOLID design, FastAPI, PyQt5, SQLite, automated testing'],
  ['Data & automation', 'n8n workflows, data pipelines, data visualisation, MLOps'],
];
const certs = [
  { img: aou, title: 'Fundamentals of Data Science and Machine Learning', by: 'Arab Open University, Jun – Aug 2024' },
  { img: jelecom, title: 'Machine Learning Basics, 40 hours, graded Excellent', by: 'Jelecom Egypt, Aug – Sep 2023' },
];
---
<Base>
  <section class="hero" id="home">
    <Heatmap />
    <div class="wrap">
      <h1><span class="det"><span class="tagbox" aria-hidden="true">ai_engineer 0.99</span>Marwan<br />Hatem</span></h1>
      <p class="intro">I build AI systems that work outside the notebook: medical image classifiers, on-device vision and language tools, and automated LLM pipelines.</p>
      <div class="actions">
        <a href="#projects" class="btn fill">See projects</a>
        <a href="/Marwan_Hatem_CV.pdf" download class="btn line">Download CV (PDF)</a>
      </div>
    </div>
    <div class="legend" aria-hidden="true">low <i></i> attention</div>
  </section>

  <section class="block" id="projects">
    <div class="wrap">
      <h2>Projects I designed and built end to end</h2>
      <div class="index">
        {projects.map((p, i) => (
          <a class:list={['row', { lead: i === 0 }]} href={`${base}/projects/${p.id}/`}>
            <div class="when">{p.data.category}{p.data.date && <><br />{p.data.date}</>}</div>
            <div><h3>{p.data.title}</h3><p>{p.data.summary}</p></div>
            <div class="stack">{p.data.tags.join(', ')}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="about">
    <div class="wrap">
      <h2>About me</h2>
      <div class="about">
        <div>
          <p>I'm an AI engineering student in Cairo with training in machine learning and deep learning, and I like turning that theory into software people can actually run.</p>
          <p>Most of my projects combine a trained model with the product around it: a dashboard, a desktop app, or an n8n workflow that connects AI steps so a whole process runs on its own.</p>
          <p>Outside the code I bring leadership, teamwork and clear communication, and I'm looking for an AI engineering role where I can keep learning on hard problems.</p>
        </div>
        <ol class="path" aria-label="Education and training">
          {path.map(([when, what, desc]) => (
            <li><time>{when}</time><h3>{what}</h3><p>{desc}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="block" id="skills">
    <div class="wrap">
      <h2>What I work with</h2>
      <dl class="skills">
        {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="soft"><b>Also:</b> leadership, teamwork, presentations, time management, project management, problem solving.</p>
    </div>
  </section>

  <section class="block" id="certificates">
    <div class="wrap">
      <h2>Certificates</h2>
      <div class="certs">
        {certs.map((c) => (
          <figure class="cert">
            <div class="frame"><Image src={c.img} alt={`Certificate: ${c.title}`} widths={[400, 700]} sizes="(min-width:860px) 340px, 100vw" loading="lazy" /></div>
            <figcaption><h3>{c.title}</h3><p>{c.by}</p></figcaption>
          </figure>
        ))}
        <a class="cert" href="/certificates/depi-data-engineer.pdf" target="_blank" rel="noopener">
          <div class="frame"><span>Digital Egypt Pioneers Program</span></div>
          <div><h3>Microsoft Data Engineer track, DEPI</h3><p>Jun – Dec 2025. Opens the PDF certificate.</p></div>
        </a>
      </div>
    </div>
  </section>

  <section class="block" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <div class="contact">
        <div>
          <p class="lead-p">Hiring for an AI role, or have a project in mind? Email me or use the form.</p>
          <p style="margin-top:24px"><a class="mail" href="mailto:marwan55hatem@gmail.com">marwan55hatem@gmail.com</a></p>
          <div class="facts">
            <span>Phone and WhatsApp: <a href="tel:+201006453612">+20 100 645 3612</a></span>
            <span>Based in Gesr Al Suez, Cairo, Egypt</span>
            <span><a href="https://github.com/marwan55hatem" target="_blank" rel="noopener">GitHub</a>, <a href="https://www.linkedin.com/in/marwan-hatem/" target="_blank" rel="noopener">LinkedIn</a></span>
          </div>
        </div>
        <form id="form" action="https://formspree.io/f/xqayjrdg" method="POST">
          <div><label for="n">Your name</label><input id="n" name="name" required autocomplete="name" /></div>
          <div><label for="e">Your email</label><input id="e" type="email" name="email" required autocomplete="email" /></div>
          <div><label for="m">Message</label><textarea id="m" name="message" required></textarea></div>
          <div><button class="btn fill" id="send" type="submit">Send message</button></div>
          <div id="fs" role="status"></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const fs = document.getElementById('fs')!;
  const send = document.getElementById('send') as HTMLButtonElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    send.disabled = true; fs.className = ''; fs.textContent = 'Sending…';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error();
      fs.className = 'ok'; fs.textContent = 'Message sent. I will reply by email.'; form.reset();
    } catch {
      fs.className = 'err'; fs.textContent = 'The message did not send. Check your connection or email me directly.';
    } finally { send.disabled = false; }
  });
</script>
